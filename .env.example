# Choose one runtime.
# Direct Claude/OpenAI satisfy the literal assignment requirement.
# Ollama is the recommended no-cloud development/fallback runtime.
BROWSER_AGENT_PROVIDER=ollama

# Local Ollama (no API key)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b

# Anthropic / Claude
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=replace_with_current_supported_model

# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_MODEL=replace_with_current_supported_model

# Development fallback
GROQ_API_KEY=replace_me
GROQ_MODEL=openai/gpt-oss-120b
